[sub_resource type="GDScript" id="GDScript_2fv5g"]
script/source = "extends Area3D
class_name TurbulenceVolume

@export var intensity: float = 1.0
@export var size: Vector3 = Vector3(1000,1000,1000)
@export var movement_speed: Vector3 = Vector3(5, 0, 2)
@export var shake_factor: float = 0.1
@export var lifetime: float = 10.0  # How long before it despawns

@export var wind_sound: AudioStream
@export var max_volume_db: float = 10#-10.0
@export var min_volume_db: float = -40.0

var affected_bodies: Array = []
var age: float = 0.0
var audio_player: AudioStreamPlayer3D

func _ready():
	# Set up collision detection
	var collision = CollisionShape3D.new()
	var box_shape = BoxShape3D.new()
	box_shape.size = size
	collision.shape = box_shape
	add_child(collision)
	
	# Connect signals
	body_entered.connect(_on_body_entered)
	body_exited.connect(_on_body_exited)
	
	# Set up wind sound
	if wind_sound:
		audio_player = AudioStreamPlayer3D.new()
		add_child(audio_player)
		audio_player.stream = wind_sound
		audio_player.autoplay = true
		audio_player.max_distance = size.length()  # Audible across the whole volume
		audio_player.unit_size = size.length() * 0.3  # Sound source size
		audio_player.volume_db = min_volume_db
	
	# Force loop mode
	if wind_sound is AudioStreamWAV:
		wind_sound.loop_mode = AudioStreamWAV.LOOP_FORWARD
	audio_player.autoplay = true

func _physics_process(delta):
	age += delta
	
	# Move the turbulence volume
	global_position += movement_speed * delta
	
	# Apply turbulence to all bodies inside
	for body in affected_bodies:
		if body and is_instance_valid(body):
			apply_turbulence_to_body(body)
	
	# Update wind sound volume based on intensity and proximity
	if audio_player:
		# Volume scales with turbulence intensity
		var target_volume = lerp(min_volume_db, max_volume_db, intensity / 2.0)
		
		# Find closest affected body for additional scaling
		var closest_distance = 999999.0
		for body in affected_bodies:
			if body and is_instance_valid(body):
				var distance = global_position.distance_to(body.global_position)
				closest_distance = min(closest_distance, distance)
		
		# Fade volume based on distance to closest aircraft
		if closest_distance < 999999.0:
			var distance_factor = 1.0 - clamp(closest_distance / (size.length() * 0.5), 0.0, 1.0)
			target_volume += (max_volume_db - target_volume) * distance_factor
		
		audio_player.volume_db = target_volume
		audio_player.pitch_scale = 0.8 + (intensity / 2.0) * 0.4  # Higher pitch for stronger wind
	
	# Self-destruct after lifetime
	if age > lifetime:
		queue_free()

func apply_turbulence_to_body(body: RigidBody3D):
	# Get velocity for scaling (faster = more turbulence felt)
	var velocity = body.linear_velocity.length()
	var velocity_factor = clamp(velocity / 50.0, 0.1, 2.0)  # Scale between 0.1x and 2x
	
	# Apply random forces
	var turbulence_force = Vector3(
		randf_range(-intensity, intensity),
		randf_range(-intensity * 0.3, intensity * 0.3),  # Less vertical
		randf_range(-intensity, intensity)
	) * velocity_factor
	
	body.apply_central_force(turbulence_force)
	
	# Add shake if the body supports it (modular - works if method exists)
	if body.has_method(\"add_shake\"):
		body.add_shake(intensity * shake_factor * velocity_factor, 0.1)

func _on_body_entered(body: Node3D):
	if body is RigidBody3D:
		affected_bodies.append(body)
		print(\"Aircraft entered turbulence zone with intensity: \", intensity)

func _on_body_exited(body: Node3D):
	if body in affected_bodies:
		affected_bodies.erase(body)
"

