[layer_names]

3d_physics/layer_5="Tailhook"
3d_physics/layer_6="Cable"
3d_physics/layer_10="Terrain"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_interpolation=true
common/enable_pause_aware_picking=true

[rendering]

textures/canvas_textures/default_texture_filter=0
textures/canvas_textures/default_texture_repeat=1
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=0
reflections/sky_reflections/texture_array_reflections=false
shading/overrides/force_vertex_shading=true
shading/overrides/force_lambert_over_burley=true
environment/ssao/blur_passes=0
environment/ssao/enabled=false
environment/ssil/enabled=false
reflections/ssr/roughness_quality=0
reflections/ssr/enabled=false
textures/default_filters/texture_filter=0
gi/use_sdfgi=false
volumetric_fog/enabled=false
lights_and_shadows/directional_shadow/max_distance=800.0
lights_and_shadows/shadow_atlas/size=4096
quality/3d/render_scale=1.0
lights_and_shadows/directional_shadow/stabilize=true
lights_and_shadows/directional_shadow/blend_splits=true
