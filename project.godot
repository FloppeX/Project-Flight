; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Project Flight"
run/main_scene="res://Main_Scene.tscn"
config/features=PackedStringArray("4.4")
config/icon="res://icon.png"

[audio]

buses/default_bus_layout=""

[autoload]

EnemyRegistry="*res://Enemies/EnemyRegistry.gd"
ControllerDebug="*res://tools/ControllerDebug.gd"
TerrainNavGrid="*res://TerrainNavGrid.gd"
FlightDirector="*res://FlightDirector.gd"

[display]

window/size/mode=3
window/stretch/mode="2d"
window/stretch/aspect="keep_height"

[editor_plugins]

enabled=PackedStringArray("res://addons/simplified_flightsim/plugin.cfg")

[global_group]

tailhook=""

[gui]

common/drop_mouse_on_gui_input_disabled=true

[input]

pitch_up={
"deadzone": 0.15,
"events": [Object(InputEventJoypadMotion,"resource_local_to_scene":false,"resource_name":"","device":-1,"axis":1,"axis_value":1.0,"script":null)
]
}
