; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Land Carrier"
run/main_scene="res://UI/MainMenu.tscn"
config/features=PackedStringArray("4.6")
boot_splash/image="res://Images/Splash/splash screen 8.png"
config/icon="res://Images/icon.png"

[audio]

buses/default_bus_layout=""

[autoload]

EnemyRegistry="*res://Enemies/EnemyRegistry.gd"
ControllerDebug="*res://tools/ControllerDebug.gd"
TerrainNavGrid="*res://Environment/TerrainNavGrid.gd"
TerrainReference="*res://Environment/TerrainReference.gd"
VelocityFrame="*res://Environment/VelocityFrame.gd"
GameSession="*res://GameSession.gd"
LoadingScreen="*res://UI/LoadingScreen.gd"
PauseMenu="*res://UI/PauseMenu.gd"
WorldMapOverlay="*res://UI/WorldMapOverlay.gd"
PilotRosterOverlay="*res://UI/PilotRosterOverlay.gd"
FlightDirector="*res://AirOps/FlightDirector.gd"
PilotRoster="*res://AirOps/PilotRoster.gd"
AirOpsManager="*res://AirOps/AirOpsManager.gd"
RadioComms="*res://Radio/RadioComms.gd"
CombatLog="*res://Debug/CombatLog.gd"
NavGraph="*res://AI/NavGraph.gd"
NavPathScheduler="*res://AI/NavPathScheduler.gd"
HelicopterCombatTuner="*res://AI/HelicopterCombatTuner.gd"
HelicopterNavigationTuner="*res://AI/HelicopterNavigationTuner.gd"
ParticleManager="*res://Effects/ParticleManager.gd"
EnemyVisualBudget="*res://Effects/EnemyVisualBudget.gd"
GroundOpsManager="*res://GroundOps/GroundOpsManager.gd"
EnemyBaseManager="*res://Enemies/EnemyBaseManager.gd"
EnemyOpsManager="*res://Enemies/EnemyOpsManager.gd"
ScreenshotCapture="*res://tools/ScreenshotCapture.gd"
FPSCounter="*res://tools/FPSCounter.gd"
Livery="*res://Aircraft/Livery.gd"
FloatingOrigin="*res://Environment/FloatingOrigin.gd"
POIManager="*res://POI/POIManager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=4
window/stretch/mode="viewport"
window/vsync/vsync_mode=0

[editor_plugins]

enabled=PackedStringArray("res://addons/simplified_flightsim/plugin.cfg")

[filesystem]

import/blender/enabled=false

[global_group]

tailhook=""

[gui]

common/drop_mouse_on_gui_input_disabled=true

